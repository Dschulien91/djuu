[Unit]
Description=Djuu nightly event refresh (see /opt/djuu/refresh.sh)
After=docker.service network-online.target
Wants=network-online.target
# a failed run mails the PocketBase superuser address (server/alert.py)
OnFailure=djuu-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/djuu/refresh.sh
# never let a hanging provider block the next night
TimeoutStartSec=4h
Nice=10
