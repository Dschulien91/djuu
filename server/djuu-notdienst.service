[Unit]
Description=Djuu emergency pharmacies of today and tomorrow (see /opt/djuu/live.sh)
After=docker.service network-online.target
Wants=network-online.target
# a failed run mails the PocketBase superuser address (server/alert.py)
OnFailure=djuu-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/djuu/live.sh notdienst
TimeoutStartSec=10min
Nice=10
